<Window x:Class="Reinforcement.StatistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Reinforcement"
        mc:Ignorable="d"
        Title="Статистика"
        Width="800" Height="450"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: настройки (в ScrollViewer) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: подпись "Вид текстовой статистики" -->
            <RowDefinition Height="Auto"/>
            <!-- 3: ComboBox текстового вида -->
            <RowDefinition Height="*"/>
            <!-- 4: TextBox (занимает всё оставшееся) -->
            <RowDefinition Height="Auto"/>
            <!-- 5: разделитель -->
            <RowDefinition Height="Auto"/>
            <!-- 6: кнопки -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
               Text="Настройки статистики"
               FontSize="16" FontWeight="SemiBold"
               Margin="0,0,0,10"/>

        <!-- Настройки -->
        <ScrollViewer Grid.Row="1"
                  MaxHeight="200"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel">
                <TextBlock Text="Статистика за дней:" Margin="0,0,0,4"/>
                <TextBox x:Name="DaysBackBox"
                 Width="100"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12"
                 Text="100"
                 PreviewTextInput="DaysBackBox_PreviewTextInput"
                 LostFocus="DaysBackBox_LostFocus"/>
                <TextBlock Text="Вид статистики:" Margin="0,0,0,4"/>
                <ComboBox x:Name="ReportKindCombo"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,12"
                      SelectionChanged="ReportKindCombo_SelectionChanged"/>

                <CheckBox x:Name="ServerOnlyCheck"
                      Content="Только серверные модели"
                      Margin="0,0,0,12"
                      Checked="ServerOnlyCheck_Changed"
                      Unchecked="ServerOnlyCheck_Changed"/>

                <TextBlock x:Name="StatusText"
                       Text="Данные ещё не загружены."
                       Foreground="Gray"
                       FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Вид текстовой статистики -->
        <TextBlock Grid.Row="2"
               Text="Вид текстовой статистики:"
               Margin="0,8,0,4"/>
        <ComboBox x:Name="TextReportKindCombo"
              Grid.Row="3"
              Width="300"
              HorizontalAlignment="Left"
              Margin="0,0,0,8"/>

        <!-- Многострочный вывод -->
        <TextBox x:Name="ReportTextBox"
             Grid.Row="4"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="True"
             FontFamily="Consolas"
             FontSize="12"
             Padding="4"/>

        <!-- Разделитель -->
        <Separator Grid.Row="5" Margin="0,10,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
            <Button Content="Вгрузить статистику"
                Width="140" Height="26" Margin="0,0,8,0"
                IsDefault="True"
                Click="LoadStat_Click"/>

            <Button Content="Показать текст"
                Width="120" Height="26" Margin="0,0,8,0"
                Click="ShowTextStat_Click"/>

            <Button Content="Показать статистику"
                Width="140" Height="26" Margin="0,0,8,0"
                Click="GetStatistics_Click"/>

            <Button Content="Сохранить"
                Width="100" Height="26" Margin="0,0,8,0"
                Click="SaveButton_Click"/>

            <Button Content="Отмена"
                Width="100" Height="26"
                IsCancel="True"
                Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>