<Window x:Class="Reinforcement.ErrorAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка Revit (админ-режим)"
        Width="760" Height="440"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Зафиксирована ошибка:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="ErrorText"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="4"/>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="DisableButton"
                    DockPanel.Dock="Left"
                    Content="Отключить вывод ошибок"
                    Width="200" Height="26"
                    Click="Disable_Click"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Content="Копировать"
                        Width="110" Height="26" Margin="0,0,8,0"
                        Click="Copy_Click"/>
                <Button Content="Закрыть"
                        Width="100" Height="26"
                        IsDefault="True"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>