<Window x:Class="Reinforcement.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="400" Height="300" MinWidth="350" MinHeight="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,10,20,20">
            <TextBlock Text="Общие настройки" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <CheckBox x:Name="chkFillAuthor"
                      Content="Заполнять автора (ЕС_Автор)"
                      IsChecked="True"
                      Margin="0,5,0,5"/>

            <CheckBox x:Name="chk_GroupPass"
           Content="Обходить группы при заполнении автора"
           IsChecked="False"
           Margin="0,5,0,5"/>
            
            <CheckBox x:Name="chkUpdater"
            Content="Все Апдейтеры включены (выноски, авторы...)"
            IsChecked="True"
            Margin="0,5,0,5"/>

            <!-- Другие булевы настройки можно добавить аналогично -->
            <!--
            <CheckBox x:Name="chkSomeOtherOption"
                      Content="Другая настройка"
                      IsChecked="False"
                      Margin="0,5,0,5"/>
            -->

            <Separator Margin="0,15,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="100" Height="25" Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="100" Height="25"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>