<Window x:Class="Reinforcement.WPF_FOP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="400" Height="300" MinWidth="350" MinHeight="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,10,20,20">
            <TextBlock Text="Запись из ФОП в параметры Проекта" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Параметры из ФОП x,y,z..." Margin="0,0,0,5" FontSize="13"/>
            <TextBox x:Name="namesFop"
         Margin="0,0,0,10"
         Text="ЕС_Автор,ЕС_Посл Автор" />
            
            <CheckBox x:Name="chkIdentity"
                      Content="добавить в Идентификация"
                      IsChecked="True"
                      Margin="0,5,0,5"/>
            <CheckBox x:Name="chkGeneral"
           Content="добавить в Общие"
           IsChecked="False"
           Margin="0,5,0,5"/>
            <CheckBox x:Name="chkData"
           Content="добавить в Данные"
           IsChecked="False"
           Margin="0,5,0,5"/>
            <CheckBox x:Name="chkText"
            Content="добавить в Текст"
            IsChecked="False"
            Margin="0,5,0,5"/>


            <!-- Другие булевы настройки можно добавить аналогично -->
            <!--
            <CheckBox x:Name="chkSomeOtherOption"
                      Content="Другая настройка"
                      IsChecked="False"
                      Margin="0,5,0,5"/>
            -->

            <Separator Margin="0,15,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="100" Height="25" Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="100" Height="25"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>