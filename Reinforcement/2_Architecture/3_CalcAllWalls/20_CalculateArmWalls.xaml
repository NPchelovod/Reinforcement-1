<Window x:Class="Reinforcement.CalculateArmWalls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Reinforcement._2_Architecture.CalculateReinforcementArchitectureWalls.View"
        mc:Ignorable="d"
        Title="Вычисление армирования в АР стенах"
        SizeToContent="WidthAndHeight"
        MinWidth="580" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Кнопки заголовка -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- заголовок -->
                <RowDefinition Height="*"/>
                <!-- прокручиваемый контент -->
                <RowDefinition Height="Auto"/>
                <!-- кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- ============ ЗАГОЛОВОК ============ -->
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Вычисление армирования в АР стенах"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,4,0">
                        <Button Content="—" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Свернуть"
                                Click="MinimizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Закрыть"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ ПРОКРУЧИВАЕМАЯ ЧАСТЬ ============ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="Ввод информации" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,10,0,0" />
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Кирпичные стены ============ -->
                    <TextBlock Text="Кирпичные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов армирования на этаж" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding NumberOfRowsInBricks}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Шаг деталей (крепление к перекрытию), мм" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding StepOfTopJointsInBricks}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество боковых деталей на этаж данной высоты" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding NumberOfSideJointsInBricks}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают окна" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForBricksWindow}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают двери" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForBricksDoor}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают витражи" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForBricksCurtains}"/>
                    </StackPanel>

                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Газобетонные стены ============ -->
                    <TextBlock Text="Газобетонные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов армирования на этаж" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding NumberOfRowsInGasConcrete}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Шаг деталей (крепление к перекрытию), мм" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding StepOfTopJointsInGasConcrete}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество боковых деталей на этаж данной высоты" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding NumberOfSideJointsInGasConcrete}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают окна" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForGasConcreteWindow}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают двери" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForGasConcreteDoor}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество рядов арм., которое перерезают витражи" Margin="7" Width="300"/>
                        <TextBox Width="200" Margin="7" Text="{Binding RowsOfReductionReinforcementForGasConcreteCurtains}"/>
                    </StackPanel>

                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Настройки ============ -->
                    <TextBlock Text="Настройки заполнения параметров" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <CheckBox Content="1.1 Брать для расчета параметры из значение ЕС_параметр стен (игнорировать настройки)"
                              IsChecked="{Binding ReadParametersFromWalls}" Margin="20,5,7,0"/>
                    <CheckBox Content="2.1 Заполнять параметры самим стенам в проекте"
                              IsChecked="{Binding FillParametersInProject}" Margin="20,5,7,0"/>
                    <CheckBox Content="2.2 Не заполнять заполненные параметры (перезаписывать только нулевые)"
                              IsChecked="{Binding SkipFilledParameters}" Margin="20,3,7,0"/>

                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Результаты ============ -->
                    <TextBlock Text="Результаты расчета" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <TextBlock Text="Кирпичные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (п.м.)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInBricks, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (п.м.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding LengthOfVilatermInBricks, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (м²)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInBricksM2, StringFormat=F2}"/>
                        <TextBlock Text="" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Visibility="Hidden"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Крепление к перекрытию (шт.)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding NumberOfJointsInBricks}"/>
                        <TextBlock Text="Крепление к стенам (шт.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding TotalNumberOfSideJointsInBricks}"/>
                    </StackPanel>
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <TextBlock Text="Газобетонные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (п.м.)" Margin="7" Width="170"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInGasConcrete, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (п.м.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding LengthOfVilatermInGasConcrete, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (м²)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInGasConcreteM2, StringFormat=F2}"/>
                        <TextBlock Text="" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Visibility="Hidden"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Крепление к перекрытию (шт.)" Margin="7" Width="170"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding NumberOfJointsInGasConcrete}"/>
                        <TextBlock Text="Крепление к стенам (шт.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding TotalNumberOfSideJointsInGasConcrete}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ КНОПКИ, ВСЕГДА ВНИЗУ ============ -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Border Height="1" Background="Gray"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                    <Button Content="Выполнить" Width="100" Margin="0,0,50,0" Click="OnRunClick"/>
                    <Button Content="Закрыть"   Width="100"                 Click="OnCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>