<Window x:Class="Reinforcement.CalculateArmWalls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Reinforcement._2_Architecture.CalculateReinforcementArchitectureWalls.View"
        mc:Ignorable="d"
        Title="Вычисление армирования в АР стенах"
        SizeToContent="WidthAndHeight"
        MinWidth="720" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Стиль для строки «пояснение» в таблице исходных данных -->
        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2,2,2"/>
        </Style>

        <!-- Стиль для «текстовой» ячейки-заголовка параметра -->
        <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,4,2,4"/>
        </Style>
        <!-- ================== ПОДСВЕТКА НЕАКТИВНОЙ ГРУППЫ ================== -->
        <!-- «Шаг» красим красным, когда чекбокс «Из шага» ВЫКЛ (считаем по рядам) -->
        <Style x:Key="StepValTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                    <Setter Property="ToolTip" Value="Не используется при расчёте (считаем по рядам)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- «Ряды» красим красным, когда чекбокс «Из шага» ВКЛ (считаем по шагу) -->
        <Style x:Key="RowsValTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                    <Setter Property="ToolTip" Value="Не используется при расчёте (считаем по шагу)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Кнопки заголовка -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ ЗАГОЛОВОК ============ -->
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Вычисление армирования в АР стенах"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,4,0">
                        <Button Content="—" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Свернуть"
                                Click="MinimizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Закрыть"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ ПРОКРУЧИВАЕМАЯ ЧАСТЬ ============ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="Ввод информации" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,10,0,0" />
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ========================================================== -->
                    <!--  ЕДИНАЯ ТАБЛИЦА: Параметр | Кирпич | Газобетон | Примечание -->
                    <!-- ========================================================== -->
                    <Grid Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 0: заголовки колонок -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: Способ расчёта -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: Шаг армирования, мм -->
                            <RowDefinition Height="Auto"/>
                            <!-- 3: Рядов армирования, шт -->
                            <RowDefinition Height="Auto"/>
                            <!-- 4: Шаг деталей по бокам, мм -->
                            <RowDefinition Height="Auto"/>
                            <!-- 5: Рядов деталей, шт -->
                            <RowDefinition Height="Auto"/>
                            <!-- 6: Шаг деталей у перекрытия, мм -->
                            <RowDefinition Height="Auto"/>
                            <!-- 7: Доп. верхних рядов, шт -->
                            <RowDefinition Height="Auto"/>
                            <!-- 8: Рядов перерезает окно -->
                            <RowDefinition Height="Auto"/>
                            <!-- 9: Рядов перерезает дверь -->
                            <RowDefinition Height="Auto"/>
                            <!-- 10: Рядов перерезает витраж -->
                            <RowDefinition Height="Auto"/>
                            <!-- 11: Длина арматурины в детали, мм -->
                            <RowDefinition Height="Auto"/>
                            <!-- 12: Арматурин на деталь, шт -->
                        </Grid.RowDefinitions>

                        <!-- 0. Заголовки -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Параметр" FontWeight="Bold" Margin="4,4,2,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Кирпич"   FontWeight="Bold" HorizontalAlignment="Center" Margin="2,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Газобетон" FontWeight="Bold" HorizontalAlignment="Center" Margin="2,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Примечание" FontWeight="Bold" Margin="4,4,2,4"/>

                        <!-- 1. Способ расчёта -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Способ расчёта" Style="{StaticResource ParamLabelStyle}"/>
                        <CheckBox  Grid.Row="1" Grid.Column="1" Content="Из шага" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsChecked="{Binding CalcFromStepInBricks}"
                                   ToolTip="Если вкл — расчёт по Wall_Arm_Row_Step_m; иначе — по Wall_Arm_Rows"/>
                        <CheckBox  Grid.Row="1" Grid.Column="2" Content="Из шага" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsChecked="{Binding CalcFromStepInConcrete}"
                                   ToolTip="Если вкл — расчёт по Wall_Arm_Row_Step_m; иначе — по Wall_Arm_Rows"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Вкл — шаг, выкл — ряды" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 2. Шаг армирования на этаж -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Шаг армирования на этаж, мм" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
         Style="{StaticResource StepValTextBoxStyle}"
         Tag="{Binding CalcFromStepInBricks}"
         Text="{Binding StepArmOfRowsInBricks}"/>
                        <TextBox Grid.Row="2" Grid.Column="2"
         Style="{StaticResource StepValTextBoxStyle}"
         Tag="{Binding CalcFromStepInConcrete}"
         Text="{Binding StepArmOfRowsInConcrete}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Шаг основных рядов" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 3. Рядов армирования -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Рядов армирования, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
         Style="{StaticResource RowsValTextBoxStyle}"
         Tag="{Binding CalcFromStepInBricks}"
         Text="{Binding ArmRowsInBricks}"/>
                        <TextBox Grid.Row="3" Grid.Column="2"
         Style="{StaticResource RowsValTextBoxStyle}"
         Tag="{Binding CalcFromStepInConcrete}"
         Text="{Binding ArmRowsInConcrete}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Кол-во основных рядов" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 4. Шаг деталей по бокам -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Шаг деталей по бокам, мм" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
         Style="{StaticResource StepValTextBoxStyle}"
         Tag="{Binding CalcFromStepInBricks}"
         Text="{Binding StepOfHorJointsInBricks}"/>
                        <TextBox Grid.Row="4" Grid.Column="2"
         Style="{StaticResource StepValTextBoxStyle}"
         Tag="{Binding CalcFromStepInConcrete}"
         Text="{Binding StepOfHorJointsInGasConcrete}"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Шаг боковых деталей" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 5. Рядов деталей -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Рядов деталей, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1"
         Style="{StaticResource RowsValTextBoxStyle}"
         Tag="{Binding CalcFromStepInBricks}"
         Text="{Binding DetailRowsInBricks}"/>
                        <TextBox Grid.Row="5" Grid.Column="2"
         Style="{StaticResource RowsValTextBoxStyle}"
         Tag="{Binding CalcFromStepInConcrete}"
         Text="{Binding DetailRowsInConcrete}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Кол-во рядов боковых деталей" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 6. Шаг деталей у перекрытия -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Шаг деталей к перекрытию, мм" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding StepOfTopJointsInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="6" Grid.Column="2" Text="{Binding StepOfTopJointsInGasConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Text="Шаг деталей у перекрытия" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 7. Доп. верхних рядов -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Доп. верхних рядов арматуры, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding CountDopArmInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="7" Grid.Column="2" Text="{Binding CountDopArmInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="7" Grid.Column="3" Text="Доп. ряды у потолка" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 8. Рядов перерезает окно -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Рядов перерезает окно, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding ArmRowsWindowInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="8" Grid.Column="2" Text="{Binding ArmRowsWindowInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="8" Grid.Column="3" Text="Прерывает окно" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 9. Рядов перерезает дверь -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Рядов перерезает дверь, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="9" Grid.Column="1" Text="{Binding ArmRowsDoorInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="9" Grid.Column="2" Text="{Binding ArmRowsDoorInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="9" Grid.Column="3" Text="Прерывает дверь" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 10. Рядов перерезает витраж -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Рядов перерезает витраж, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding ArmRowsVitrageInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="10" Grid.Column="2" Text="{Binding ArmRowsVitrageInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="10" Grid.Column="3" Text="Прерывает витраж" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 11. Длина арматурины в детали -->
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Длина арматурины в детали, мм" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding ObramLengthInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="11" Grid.Column="2" Text="{Binding ObramLengthInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="11" Grid.Column="3" Text="Длина стержня в детали" Style="{StaticResource NoteTextStyle}"/>

                        <!-- 12. Арматурин на деталь -->
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Арматурин на одну деталь, шт" Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox   Grid.Row="12" Grid.Column="1" Text="{Binding ObramCountInBricks}"   Margin="2,2"/>
                        <TextBox   Grid.Row="12" Grid.Column="2" Text="{Binding ObramCountInConcrete}" Margin="2,2"/>
                        <TextBlock Grid.Row="12" Grid.Column="3" Text="Стержней в детали" Style="{StaticResource NoteTextStyle}"/>
                    </Grid>

                   

                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Настройки (пользовательские) ============ -->
                    <TextBlock Text="Настройки" HorizontalAlignment="Center"
                               FontSize="16" FontWeight="Bold" />
                    <CheckBox Content="Экспортировать расчёт деталей"
                              IsChecked="{Binding ExportDetailCalculation}"
                              Margin="20,5,7,0"
                              ToolTip="Если вкл — в результатах и при заполнении параметров учитываются детали (крепления)"/>
                    
                    
                    
                    
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                   
                    <!-- ============ Настройки ============ -->
                    <TextBlock Text="//не трогать - не работает пока//Настройки заполнения параметров" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <CheckBox Content="1.1 Брать для расчета параметры из значение ЕС_параметр стен (игнорировать настройки)"
                              IsChecked="{Binding ReadParametersFromWalls}" Margin="20,5,7,0"/>
                    <CheckBox Content="2.1 Заполнять параметры самим стенам в проекте"
                              IsChecked="{Binding FillParametersInProject}" Margin="20,5,7,0"/>
                    <CheckBox Content="2.2 Не заполнять заполненные параметры (перезаписывать только нулевые)"
                              IsChecked="{Binding SkipFilledParameters}" Margin="20,3,7,0"/>

                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <!-- ============ Результаты ============ -->
                    <TextBlock Text="Результаты расчета" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <TextBlock Text="Кирпичные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (п.м.) (1 ряд)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInBricks, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (п.м.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding LengthOfVilatermInBricks, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (м²)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInBricksM2, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (м²)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding AreaOfVilatermInBricks, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Крепление к перекрытию (шт.)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding NumberOfJointsInBricks}"/>
                        <TextBlock Text="Крепление к стенам (шт.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding TotalNumberOfSideJointsInBricks}"/>
                    </StackPanel>
                    <Border Height="1" Background="Gray" Margin="0,10,0,10" />

                    <TextBlock Text="Газобетонные стены" HorizontalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (п.м.) (1 ряд)" Margin="7" Width="170"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInGasConcrete, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (п.м.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding LengthOfVilatermInGasConcrete, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Армирование (м²)" Width="170" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding ReinforcementInGasConcreteM2, StringFormat=F2}"/>
                        <TextBlock Text="Вилатерм (м²)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding AreaVilatermInGasConcreteM2, StringFormat=F2}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Крепление к перекрытию (шт.)" Margin="7" Width="170"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding NumberOfJointsInGasConcrete}"/>
                        <TextBlock Text="Крепление к стенам (шт.)" Width="140" Margin="7"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Width="90" Margin="7" BorderBrush="Gray"
                                 Text="{Binding TotalNumberOfSideJointsInGasConcrete}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ КНОПКИ, ВСЕГДА ВНИЗУ ============ -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Border Height="1" Background="Gray"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                    <Button Content="Выполнить" Width="100" Margin="0,0,50,0" Click="OnRunClick"/>
                    <Button Content="Закрыть"   Width="100"                 Click="OnCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>