<Window x:Class="Reinforcement.Aspirant.GroundLayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Reinforcement.Aspirant"
        Title="Грунтовая колонка (скважина)"
        Width="680" Height="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:FlexibleDoubleConverter x:Key="FlexDouble"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Z1 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Абс. отметка верха Z1, м:"
                       VerticalAlignment="Center" Width="240"/>
            <TextBox x:Name="TbZ1" Width="120" Text="0"
                     VerticalContentAlignment="Center"
                     TextChanged="TbZ_TextChanged"/>
        </StackPanel>

        <!-- Сдвиг -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Сдвиг отметки (чистый ноль), м:"
                       VerticalAlignment="Center" Width="240"/>
            <TextBox x:Name="TbZeroPoint" Width="120" Text="0"
                     VerticalContentAlignment="Center"
                     TextChanged="TbZ_TextChanged"/>
        </StackPanel>

        <!-- Номер + X + Y -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Номер колонки:" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="TbColumnNumber" Width="60" Text="1"
                     VerticalContentAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="X, м:" VerticalAlignment="Center" Width="40"/>
            <TextBox x:Name="TbX" Width="80" Text="0"
                     VerticalContentAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="Y, м:" VerticalAlignment="Center" Width="40"/>
            <TextBox x:Name="TbY" Width="80" Text="0"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Превью -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock x:Name="TbZPreview"
                       FontWeight="SemiBold" Foreground="DarkBlue"/>
            <TextBlock x:Name="TbBasePointInfo" Margin="0,2,0,0"
                       Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить слой" Width="120" Margin="0,0,6,0"
                    Click="AddLayer_Click"/>
            <Button Content="Удалить слой" Width="120" Margin="0,0,12,0"
                    Click="RemoveLayer_Click"/>
            <Button Content="Импорт CSV…" Width="120" Margin="0,0,6,0"
                    Click="ImportCsv_Click"/>
            <Button Content="Экспорт CSV…" Width="120"
                    Click="ExportCsv_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="5"
                  x:Name="GridLayers"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Margin="0,0,0,8"
                  PreparingCellForEdit="GridLayers_PreparingCellForEdit">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование грунта"
                                    Width="*"
                                    Binding="{Binding Name, Mode=TwoWay,
                                              UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Толщина, м"
                                    Width="140"
                                    Binding="{Binding ThicknessM, Mode=TwoWay,
                                              UpdateSourceTrigger=LostFocus,
                                              Converter={StaticResource FlexDouble}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" x:Name="TbSummary" Margin="0,0,0,8"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Создать" Width="110" Margin="0,0,6,0"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="110"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>